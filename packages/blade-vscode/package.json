{
  "name": "blade-templates",
  "displayName": "Blade Templates",
  "description": "Language support for Blade template files (.blade) - syntax highlighting, diagnostics, autocompletion, and code navigation",
  "version": "0.2.3",
  "publisher": "fponticelli",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/fponticelli/blade.git",
    "directory": "packages/blade-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "blade",
    "template",
    "html",
    "syntax highlighting",
    "preview",
    "live preview"
  ],
  "activationEvents": [
    "onLanguage:blade",
    "onWebviewPanel:bladePreview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "blade.openPreview",
        "title": "Open Preview",
        "category": "Blade",
        "icon": "$(open-preview)"
      }
    ],
    "keybindings": [
      {
        "command": "blade.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == blade"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "blade.openPreview",
          "when": "editorLangId == blade",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "blade",
        "aliases": [
          "Blade",
          "blade"
        ],
        "extensions": [
          ".blade"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "blade",
        "scopeName": "text.blade",
        "path": "./syntaxes/blade.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.expression.blade": "javascript"
        }
      }
    ],
    "configuration": {
      "title": "Blade",
      "properties": {
        "blade.lsp.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable diagnostics"
        },
        "blade.lsp.diagnostics.unusedVariables": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "hint",
            "off"
          ],
          "default": "warning",
          "description": "Severity for unused variable warnings"
        },
        "blade.lsp.diagnostics.deprecatedHelpers": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "hint",
            "off"
          ],
          "default": "warning",
          "description": "Severity for deprecated helper warnings"
        },
        "blade.lsp.diagnostics.potentiallyUndefined": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "hint",
            "off"
          ],
          "default": "hint",
          "description": "Severity for reads of a name the schema and samples do not mention"
        },
        "blade.lsp.diagnostics.deepNesting": {
          "type": "string",
          "enum": [
            "warning",
            "hint",
            "off"
          ],
          "default": "warning",
          "description": "Severity for deep nesting warnings"
        },
        "blade.lsp.diagnostics.deepNestingThreshold": {
          "type": "number",
          "default": 4,
          "description": "Maximum nesting depth before warning"
        },
        "blade.lsp.completion.dataSchemaPath": {
          "type": "string",
          "default": "",
          "description": "Path to JSON schema file for data completions"
        },
        "blade.lsp.completion.helpersDefinitionPath": {
          "type": "string",
          "default": "",
          "description": "Path to helpers definition file for completion"
        },
        "blade.lsp.completion.snippets": {
          "type": "boolean",
          "default": true,
          "description": "Enable snippet completions for directives"
        },
        "blade.lsp.performance.debounceMs": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "description": "Milliseconds to wait after a keystroke before re-parsing a document"
        },
        "blade.lsp.performance.maxFileSize": {
          "type": "number",
          "default": 1048576,
          "minimum": 1024,
          "description": "Largest file the language server will parse, in bytes. Larger files report a single diagnostic instead."
        },
        "blade.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication between VS Code and the language server"
        }
      }
    }
  },
  "scripts": {
    "esbuild:extension": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild:server": "esbuild ./node_modules/@bladets/lsp-server/dist/server.js --bundle --outfile=out/server/server.js --format=cjs --platform=node",
    "vscode:prepublish": "pnpm run esbuild:extension --minify && pnpm run esbuild:server --minify",
    "build": "pnpm run esbuild:extension --sourcemap && pnpm run esbuild:server --sourcemap",
    "watch": "pnpm run esbuild:extension --sourcemap --watch=forever & pnpm run esbuild:server --sourcemap --watch=forever & wait",
    "package": "vsce package --no-dependencies",
    "lint": "eslint src tests --ext ts --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "vsix:install": "code --install-extension blade-templates-$npm_package_version.vsix",
    "vscode": "pnpm run build && pnpm run package && pnpm run vsix:install",
    "clean": "rm -rf out coverage .turbo"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "@types/vscode": "^1.85.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@bladets/lsp-server": "workspace:*",
    "@bladets/template": "workspace:*",
    "vscode-languageclient": "^9.0.1"
  }
}
