{
  // Typechecks the test suite, which tsconfig.json excludes. Extends the
  // package config rather than the base so tests always inherit whatever
  // strictness src is held to.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The only relaxation, matching the other packages' test configs: fixtures
    // of known shape are indexed directly, and `?.` would turn an out-of-range
    // read into a silent `undefined === expected` pass instead of a failure.
    "noUncheckedIndexedAccess": false
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "out"]
}
