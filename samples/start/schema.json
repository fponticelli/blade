{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "The main title of the card"
    },
    "subtitle": {
      "type": "string",
      "description": "Optional subtitle"
    },
    "items": {
      "type": "array",
      "description": "List of items to display",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Item name"
          },
          "color": {
            "type": "string",
            "description": "Item colour"
          },
          "calories": {
            "type": "number",
            "description": "Energy per serving, in kilocalories"
          }
        },
        "required": ["name"]
      }
    }
  },
  "required": ["title", "items"]
}
