{
  "name": "blade-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.1+sha512.3590e550d5384caa39bd5c7c739f72270234b2f6059e13018f975c313b1eb9fefcc09714048765d4d9efe961382c312e624572c0420762bdc5d5940cdf9be73a",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:ui": "turbo test:ui",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "fix": "turbo lint:fix && prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "turbo typecheck",
    "typecheck:tests": "turbo typecheck:tests",
    "check": "turbo check",
    "check:bundles": "node scripts/check-bundles.mjs",
    "check:api": "node scripts/api-surface.mjs",
    "api:update": "node scripts/api-surface.mjs --write",
    "clean": "turbo clean && rm -rf node_modules",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "./scripts/publish.sh",
    "release:dry": "DRY_RUN=1 ./scripts/publish.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "turbo": "^2.8.10",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@vscode/vsce-sign",
      "keytar"
    ]
  },
  "dependencies": {
    "@changesets/cli": "^2.29.8"
  }
}
